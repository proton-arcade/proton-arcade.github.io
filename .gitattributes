# ---------------------------------------------------------------------------
# ATTRIBUTE ORDER MATTERS: for any given attribute, the LAST matching pattern
# wins. The broad text rules come first and the game-build binary rule comes
# last, so nothing can override it.
#
# Getting this wrong silently destroys the bundled games: a build such as
# website/games/Ealgercraft/Ampler-Launcher/website/mc/1.12.2/index.html is a
# 15-60 MB single file whose base64/binary payload legitimately contains CRLF
# byte pairs. Normalising it to LF corrupts the archive and the game fails to
# boot, with no warning at runtime.
#
# The same rule protects Ampler Launcher, which is vendored from
# https://github.com/proton-arcade/AmplerLauncher byte for byte. Its own
# .gitattributes is not copied in here on purpose - this file has to cover it.
# ---------------------------------------------------------------------------

# Ordinary text first.
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.command text eol=lf
*.bat  text eol=crlf

# Binary assets.
website/**/*.woff2 binary
website/**/*.zip   binary
website/**/*.png   binary
website/**/*.jpg   binary
website/**/*.jpeg  binary
website/**/*.svg   text eol=lf

# Media library (website/media/): videos and music are opaque binaries, so no
# line-ending conversion and no diffing. Cover art stays an image rule above.
website/**/*.mp4   binary
website/**/*.m4v   binary
website/**/*.mov   binary
website/**/*.webm  binary
website/**/*.ogv   binary
website/**/*.mp3   binary
website/**/*.m4a   binary
website/**/*.aac   binary
website/**/*.wav   binary
website/**/*.ogg   binary
website/**/*.oga   binary
website/**/*.opus  binary
website/**/*.flac  binary
website/**/*.weba  binary

# LAST, so they win: the bundled game builds are opaque binaries. No diff, no
# line-ending conversion, no text detection. Paths are listed one by one on
# purpose - a blanket website/games/**/index.html would also swallow the small
# hand-written pages in that folder. Add a line here for any new build that is
# shipped as one big self-contained file.
website/games/Five-nights-at-Freddys/*/index.html -text -diff
website/games/Ealgercraft/Ampler-Launcher/website/mc/** -text -diff

# The Offline-HTML-Games-Pack ports (see "Offline games pack" in the README).
# Every one of them is a single self-contained file with an embedded payload:
# their base64/zip data legitimately contains CRLF byte pairs and the vendored
# bytes are kept intact, so no line-ending conversion and no diffing.
website/games/Kart-bros/index.html -text -diff
website/games/Football-bros/index.html -text -diff
website/games/Backrooms/index.html -text -diff
website/games/Geometry-Dash-Lite/index.html -text -diff
website/games/Bloxorz/index.html -text -diff
website/games/Drift-boss/index.html -text -diff
website/games/Retro-bowl/index.html -text -diff
website/games/Pac-man/index.html -text -diff
website/games/Flappy-bird/index.html -text -diff
website/games/Minesweeper/index.html -text -diff
website/games/Google-dino/index.html -text -diff

# Keep the short provenance notes beside individual builds readable/diffable;
# the large self-contained HTML files remain protected by the rule above.
website/games/Ealgercraft/Ampler-Launcher/website/mc/**/README.md text eol=lf diff
