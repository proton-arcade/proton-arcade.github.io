website/games/Ealgercraft/Ampler-Launcher/website/server/*.jar
website/games/Ealgercraft/Ampler-Launcher/website/server/runtime/
website/games/Ealgercraft/Ampler-Launcher/website/server/logs/
website/games/Ealgercraft/Ampler-Launcher/website/server/world*/
website/games/Ealgercraft/Ampler-Launcher/website/server/eula.txt
website/games/Ealgercraft/Ampler-Launcher/website/server/plugins.txt

